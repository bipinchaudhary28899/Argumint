# Server
PORT=3000
NODE_ENV=production

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Argumint
REDIS_URL=redis://default:<password>@<host>:<port>

# Frontend URL (for CORS) — your Vercel domain
FRONTEND_URL=https://your-app.vercel.app

# OpenAI — required for Whisper transcription and AI judge
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_JUDGE_MODEL=gpt-4o-mini
