{
  "framework": null,
  "installCommand": "npm install --prefix . || true",
  "buildCommand": "cd packages/shared && npx tsc -b --force && cd ../../apps/frontend && npx vite build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "env": {
    "NODE_VERSION": "20"
  }
}
