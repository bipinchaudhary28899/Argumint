{
  "name": "argumint",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",
    "build": "npm run build --workspaces",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@argumint/shared": "^1.0.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "mongoose": "^9.2.3",
    "zod": "^4.3.6"
  }
}
